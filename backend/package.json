{
  "name": "sante-extremes-backend",
  "version": "1.0.0",
  "description": "Backend de gestion des cotisations — Santé des extrêmes (LOT 1)",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
