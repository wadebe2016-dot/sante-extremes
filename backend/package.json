    "db:backup": "node scripts/s3-db-sync.js backup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.1",
    "sqlite3": "^5.1.7"
  }
}
