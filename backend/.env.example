###############################################################################
# DeuxZero — backend : modèle de configuration
#
# Copier en .env pour un usage LOCAL uniquement :
#   cp .env.example .env
#
# AUCUNE valeur secrète dans ce fichier — il est versionné.
###############################################################################
#
# LOT 7 — LES CODES DE RÔLE NE SONT PLUS ICI.
#
# Ils vivent dans la base de chaque association (table roles_codes, hachés en
# scrypt), et c'est le PRÉSIDENT qui les distribue depuis son téléphone. Un
# produit vendu à des dizaines d'associations ne peut pas fonctionner autrement :
# l'éditeur n'entre jamais en contact avec ses clients, donc personne ne peut
# éditer un fichier à leur place.
#
# Les variables ADMIN_PASSWORD, SECRETAIRE_PASSWORD, TRESORIERS et les autres ne
# subsistent que pour la REPRISE de l'association historique (SDE001) :
# scripts/migrer-vers-multi.js les lit, les inscrit hachées en base, puis les
# retire du .env. Après cette reprise, elles n'ont plus aucun usage.
###############################################################################

# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Bases de données (LOT 7) ------------------------------------------------
# Une base SQLite PAR ASSOCIATION, plus un annuaire qui ne contient que la liste
# des associations — aucune donnée métier.
#
#   data/annuaire.db                 annuaire global
#   data/associations/<CODE>.db      une base par association
#   data/sde.db                      base historique, conservée intacte
#
# DATA_DIR est la racine de tout cela. En production : /var/lib/sde
DATA_DIR=./data

# Chemin de l'annuaire, si différent de DATA_DIR/annuaire.db
# ANNUAIRE_PATH=

# Base HISTORIQUE, lue uniquement par scripts/migrer-vers-multi.js pour la
# copier vers data/associations/SDE001.db. Le service ne l'ouvre plus.
DB_PATH=./data/sde.db

# Connexions d'association gardées ouvertes simultanément (cache LRU).
CONNEXIONS_MAX=50

# Code de l'association historique : la seule pour laquelle les codes du .env
# ci-dessous sont encore acceptés, le temps de la reprise.
ASSOCIATION_HISTORIQUE=SDE001

# Téléphone du président de l'association historique, au format +237XXXXXXXXX.
# Inscrit dans l'annuaire par le script de reprise. Sans lui, la réinitialisation
# du code président restera IMPOSSIBLE — c'est le seul numéro qui l'autorise.
PRESIDENT_TELEPHONE=

# Créations d'association autorisées par adresse IP et par heure.
CREATIONS_MAX=3

# --- Codes de rôle — REPRISE UNIQUEMENT (hérité du LOT 3) --------------------
# À RENSEIGNER SEULEMENT si l'association historique n'a pas encore été reprise.
# scripts/migrer-vers-multi.js les inscrit hachés en base puis SUPPRIME ces
# lignes du .env. Sur une installation neuve, laisser tout vide : le code
# président est remis à la création de l'association, par l'application.
#
#   ADMIN_PASSWORD        tous les droits (ouvre toutes les routes)
#   TRESORIERS            cotisations, pénalités, approbation et décaissement
#   SECRETAIRE_PASSWORD   membres, règlement intérieur, fiches santé, demandes
#   CENSEUR_PASSWORD      infliger, lever et annuler les sanctions
#   INTENDANT_PASSWORD    exprimer des besoins de dépense
#   COMPETITIONS_PASSWORD exprimer des besoins liés aux compétitions
#
# Un rôle dont la variable est vide ou absente n'est jamais accordé.
#
# Les codes font SIX CHIFFRES (LOT 3 bis). C'est court, et cela n'est tenable
# que parce que le serveur bloque une IP après cinq échecs sur quinze minutes
# (src/middleware/limiteur.js). Ne pas désactiver ce plafond.
#
# NE JAMAIS committer de vraie valeur : ces lignes sont des exemples.
ADMIN_PASSWORD=000000
SECRETAIRE_PASSWORD=000000
CENSEUR_PASSWORD=000000
INTENDANT_PASSWORD=000000
COMPETITIONS_PASSWORD=000000

# --- Trésoriers nominatifs (LOT 3 ter) ---------------------------------------
# Liste « Nom du membre:code », séparée par des virgules. Les noms doivent
# correspondre EXACTEMENT à ceux de la table members : c'est sur cette égalité
# que reposent les refus « un trésorier ne traite pas sa propre cotisation » et
# « un trésorier ne se paie pas lui-même ».
#
# TRESORIER_PASSWORD (anonyme) reste accepté comme repli, mais sans nom aucune
# de ces protections ne peut s'appliquer : préférer TRESORIERS.
TRESORIERS=Prenom NOM:000000,Autre Prenom NOM:000000

# --- Membres protégés des sanctions (LOT 3 ter) ------------------------------
# Noms séparés par des virgules. Une sanction visant l'un d'eux exige le code
# admin : sanctionner un censeur ne peut pas relever du censeur lui-même.
CENSEUR_MEMBRES=Prenom NOM

# --- AWS ---------------------------------------------------------------------
AWS_REGION=eu-west-3

# Identifiants AWS : laisser VIDE.
# En local, préférer `aws configure` / `aws sso login` (profil ~/.aws/credentials).
# En production, attacher un rôle IAM à l'instance EC2 : le SDK le détecte seul.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Justificatifs et documents (S3) -----------------------------------------
# Bucket privé recevant les justificatifs de paiement (préfixe « cotisations/ »),
# le règlement intérieur et les fiches santé (préfixe « documents/ »).
# Sans ce bucket, ces trois fonctions échouent ; le reste de l'API fonctionne.
AWS_BUCKET=

# Taille maximale d'un justificatif de paiement, en octets (5 Mo)
S3_MAX_FILE_SIZE=5242880

# Taille maximale d'un document — règlement, fiche santé (10 Mo)
S3_MAX_DOCUMENT_SIZE=10485760

# Durée de validité des URL pré-signées des documents privés, en secondes
S3_URL_DUREE_SECONDES=600

# Base des URL renvoyées pour les justificatifs. En production, la distribution
# CloudFront ; laisser vide pour retomber sur l'URL S3 directe.
PUBLIC_MEDIA_BASE_URL=

# --- Persistance de la base SQLite sur S3 (déploiement ECS uniquement) --------
# Laisser vide sur l'instance EC2 : la base y vit sur le disque.
S3_DB_BUCKET=
S3_DB_KEY=sqlite/sde.db
DB_SYNC_INTERVAL_SECONDS=300

# --- CORS --------------------------------------------------------------------
# Origines navigateur autorisées, séparées par des virgules. « * » = tout.
# L'application Android n'est pas concernée : elle n'a pas d'origine, et aucune
# politique de ce genre ne s'applique à elle.
#
# LOT 6 — la VERSION WEB, elle, est un site : le navigateur refusera toute
# réponse de l'API si son origine n'est pas déclarée ici. Sur l'instance de
# production, la ligne à poser dans le .env est exactement :
#
#   CORS_ORIGINS=https://app.santedesextremes.com
#
# Pas de barre oblique finale, le protocole compris : une origine est
# « schéma://hôte », comparée caractère pour caractère. Ajouter d'autres
# origines — une page d'essai, un second domaine — se fait par virgules.
# Laisser « * » fonctionnerait, mais ouvrirait l'API à n'importe quel site.
# LOT 7 — l'en-tête « X-Association » est déclaré dans allowedHeaders par
# src/index.js. Sans lui, le navigateur refuserait la requête préalable et la
# version web ne pourrait joindre aucune route métier.
CORS_ORIGINS=*

# --- SMS (LOT 7) -------------------------------------------------------------
# Les SMS sont le seul moyen pour un membre du bureau de récupérer un code perdu
# sans appeler l'éditeur. Configuration détaillée : docs/sms.md
#
#   infobip   routeur par défaut, actif en production
#   nexah     implémentation prête, non activée (agrégateur camerounais)
#   journal   n'envoie RIEN, écrit le SMS dans les logs — recette seulement
#
# « journal » en production rendrait toute réinitialisation inopérante et
# écrirait les codes dans les journaux. Le démarrage du service le signale.
SMS_FOURNISSEUR=infobip

# Infobip — actif par défaut
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_EXPEDITEUR=DeuxZero

# Nexah — prêt, non activé. Bascule : SMS_FOURNISSEUR=nexah + ces trois lignes.
NEXAH_BASE_URL=
NEXAH_UTILISATEUR=
NEXAH_MOT_DE_PASSE=
NEXAH_EXPEDITEUR=DeuxZero

# Politique de réessai, commune aux deux routeurs (src/services/sms/transport.js)
SMS_DELAI_MS=10000
SMS_REESSAIS=2
SMS_REPLI_MS=1000

# Réinitialisations abouties autorisées par mois et par association.
# C'est autant une protection contre l'abus qu'un plafond de facture SMS.
REINIT_QUOTA_MENSUEL=3

# --- Espace de l'éditeur (LOT 7) ---------------------------------------------
# Protège /api/admin-produit : consommation SMS et liste des associations.
# AUCUNE donnée métier n'y passe — ni membre, ni cotisation, ni montant.
#
# Ce n'est pas un code de rôle : l'éditeur n'est membre d'aucun bureau, et son
# accès ne doit dépendre d'aucune base cliente.
#
# VIDE = espace FERMÉ (503). Une variable oubliée au déploiement ne doit pas
# laisser cet espace accessible à tous.
ADMIN_PRODUIT_CODE=
