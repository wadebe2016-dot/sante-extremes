###############################################################################
# Santé des extrêmes — backend : modèle de configuration
#
# Copier en .env pour un usage LOCAL uniquement :
#   cp .env.example .env
#
# AUCUNE valeur secrète dans ce fichier — il est versionné.
# En production (ECS Fargate), rien de tout ceci n'est lu depuis un .env :
#   - les variables non sensibles sont injectées par la définition de tâche
#     (terraform/main.tf ▸ aws_ecs_task_definition.backend)
#   - ADMIN_PASSWORD vient d'AWS Secrets Manager (sde-prod/admin-password)
#   - les accès S3 viennent du rôle IAM de la tâche, sans aucune clé
###############################################################################

# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Base SQLite -------------------------------------------------------------
# Chemin local du fichier de base. En production : /app/data/sde.db
DB_PATH=./data/sde.db

# --- Authentification administrateur ----------------------------------------
# En-tête attendu : Authorization: Bearer <ADMIN_PASSWORD>
# À définir en local uniquement. NE JAMAIS committer une vraie valeur.
ADMIN_PASSWORD=changez-moi-en-local

# --- AWS ---------------------------------------------------------------------
AWS_REGION=eu-west-3

# Identifiants AWS : laisser VIDE.
# En local, préférer `aws configure` / `aws sso login` (profil ~/.aws/credentials).
# En production, le rôle IAM de la tâche ECS fournit les accès automatiquement.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Justificatifs de paiement (S3 + CloudFront) -----------------------------
# Bucket des justificatifs — sortie Terraform « uploads_bucket »
AWS_BUCKET=sde-prod-uploads-000000000000

# Taille maximale d'un justificatif, en octets (5 Mo)
S3_MAX_FILE_SIZE=5242880

# Base des URL renvoyées à l'application mobile. En production, la distribution
# CloudFront ; laisser vide en local pour retomber sur l'URL S3 directe.
PUBLIC_MEDIA_BASE_URL=

# --- Persistance de la base SQLite sur S3 ------------------------------------
# Le conteneur Fargate n'a pas de disque durable : la base est restaurée depuis
# S3 au démarrage, sauvegardée périodiquement puis à l'arrêt.
# Laisser S3_DB_BUCKET vide en local = base purement locale, aucune synchro.
S3_DB_BUCKET=
S3_DB_KEY=sqlite/sde.db
DB_SYNC_INTERVAL_SECONDS=300

# --- CORS --------------------------------------------------------------------
# Origines navigateur autorisées, séparées par des virgules. « * » = tout.
# L'application mobile n'est pas concernée (pas de politique d'origine).
CORS_ORIGINS=*
