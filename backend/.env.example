###############################################################################
# Santé des extrêmes — backend : modèle de configuration
#
# Copier en .env pour un usage LOCAL uniquement :
#   cp .env.example .env
#
# AUCUNE valeur secrète dans ce fichier — il est versionné.
# Sur l'instance de production, les codes sont saisis directement dans le .env
# du serveur ; ils ne transitent jamais par le dépôt.
###############################################################################

# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Base SQLite -------------------------------------------------------------
# Chemin local du fichier de base. En production : /var/lib/sde/sde.db
DB_PATH=./data/sde.db

# --- Codes de rôle (LOT 3) ---------------------------------------------------
# L'association ne gère pas de comptes nominatifs : chaque fonction partage un
# code, transmis par l'application en « Authorization: Bearer <code> ».
#
#   ADMIN_PASSWORD        tous les droits (ouvre toutes les routes)
#   TRESORIERS            cotisations, pénalités, approbation et décaissement
#   SECRETAIRE_PASSWORD   membres, règlement intérieur, fiches santé, demandes
#   CENSEUR_PASSWORD      infliger, lever et annuler les sanctions
#   INTENDANT_PASSWORD    exprimer des besoins de dépense
#   COMPETITIONS_PASSWORD exprimer des besoins liés aux compétitions
#
# Un rôle dont la variable est vide ou absente n'est jamais accordé.
#
# Les codes font SIX CHIFFRES (LOT 3 bis). C'est court, et cela n'est tenable
# que parce que le serveur bloque une IP après cinq échecs sur quinze minutes
# (src/middleware/limiteur.js). Ne pas désactiver ce plafond.
#
# NE JAMAIS committer de vraie valeur : ces lignes sont des exemples.
ADMIN_PASSWORD=000000
SECRETAIRE_PASSWORD=000000
CENSEUR_PASSWORD=000000
INTENDANT_PASSWORD=000000
COMPETITIONS_PASSWORD=000000

# --- Trésoriers nominatifs (LOT 3 ter) ---------------------------------------
# Liste « Nom du membre:code », séparée par des virgules. Les noms doivent
# correspondre EXACTEMENT à ceux de la table members : c'est sur cette égalité
# que reposent les refus « un trésorier ne traite pas sa propre cotisation » et
# « un trésorier ne se paie pas lui-même ».
#
# TRESORIER_PASSWORD (anonyme) reste accepté comme repli, mais sans nom aucune
# de ces protections ne peut s'appliquer : préférer TRESORIERS.
TRESORIERS=Prenom NOM:000000,Autre Prenom NOM:000000

# --- Membres protégés des sanctions (LOT 3 ter) ------------------------------
# Noms séparés par des virgules. Une sanction visant l'un d'eux exige le code
# admin : sanctionner un censeur ne peut pas relever du censeur lui-même.
CENSEUR_MEMBRES=Prenom NOM

# --- AWS ---------------------------------------------------------------------
AWS_REGION=eu-west-3

# Identifiants AWS : laisser VIDE.
# En local, préférer `aws configure` / `aws sso login` (profil ~/.aws/credentials).
# En production, attacher un rôle IAM à l'instance EC2 : le SDK le détecte seul.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Justificatifs et documents (S3) -----------------------------------------
# Bucket privé recevant les justificatifs de paiement (préfixe « cotisations/ »),
# le règlement intérieur et les fiches santé (préfixe « documents/ »).
# Sans ce bucket, ces trois fonctions échouent ; le reste de l'API fonctionne.
AWS_BUCKET=

# Taille maximale d'un justificatif de paiement, en octets (5 Mo)
S3_MAX_FILE_SIZE=5242880

# Taille maximale d'un document — règlement, fiche santé (10 Mo)
S3_MAX_DOCUMENT_SIZE=10485760

# Durée de validité des URL pré-signées des documents privés, en secondes
S3_URL_DUREE_SECONDES=600

# Base des URL renvoyées pour les justificatifs. En production, la distribution
# CloudFront ; laisser vide pour retomber sur l'URL S3 directe.
PUBLIC_MEDIA_BASE_URL=

# --- Persistance de la base SQLite sur S3 (déploiement ECS uniquement) --------
# Laisser vide sur l'instance EC2 : la base y vit sur le disque.
S3_DB_BUCKET=
S3_DB_KEY=sqlite/sde.db
DB_SYNC_INTERVAL_SECONDS=300

# --- CORS --------------------------------------------------------------------
# Origines navigateur autorisées, séparées par des virgules. « * » = tout.
# L'application mobile n'est pas concernée (pas de politique d'origine).
CORS_ORIGINS=*
