# Adresse du backend utilisée par l'application mobile.
# Copier ce fichier en .env.local puis adapter la valeur au contexte de travail.
#
#   - production (AWS)   : https://sde-api.atlastech.cm/api   ← valeur par défaut
#                          (également inscrite dans app.json ▸ extra.apiUrl,
#                           utilisée par les builds EAS)
#   - émulateur Android  : http://10.0.2.2:3000/api
#   - téléphone physique : http://<IP-du-poste>:3000/api
#   - simulateur iOS     : http://localhost:3000/api
#
# api/client.js retire le suffixe « /api » puis le rajoute par appel : les deux
# écritures (avec ou sans /api) fonctionnent.
EXPO_PUBLIC_API_URL=https://sde-api.atlastech.cm/api

# Diffusion des justificatifs de paiement (distribution CloudFront).
# Vide en développement : le backend renvoie alors l'URL S3 directe.
EXPO_PUBLIC_MEDIA_URL=https://sde-cdn.atlastech.cm
