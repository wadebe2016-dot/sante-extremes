# Adresse du backend utilisée par l'application mobile.
# Copier ce fichier en .env.local puis adapter la valeur.
#   - émulateur Android : http://10.0.2.2:3000/api
#   - téléphone physique : http://<IP-du-poste>:3000/api
#   - production        : https://api.sante-extremes.example/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
